# Werewolf Agent local override template.
# Packaged defaults live in backend/src/werewolf_agent/resources/settings/defaults.toml.
# Copy this file to .env only when you need to override a value.

# Logging overrides.
# WEREWOLF_LOG_LEVEL=INFO
# WEREWOLF_LOG_OUTPUT=file
# WEREWOLF_LOG_DIR=.werewolf-agent/logs
# WEREWOLF_LOG_FILE_NAME=werewolf-agent.jsonl
# WEREWOLF_LOG_RETENTION_DAYS=7
# WEREWOLF_LOG_THIRD_PARTY_LEVEL=WARNING

# Runtime overrides commonly used for local development.
# WEREWOLF_REVEAL_API_ENABLED=true
# WEREWOLF_ADVANCE_JOB_POLL_INTERVAL_SECONDS=0.25
# WEREWOLF_ADVANCE_JOB_POLL_TIMEOUT_SECONDS=60
# WEREWOLF_STREAMLIT_AUTO_ADVANCE_INTERVAL_SECONDS=1.0
# WEREWOLF_STREAMLIT_LANGUAGE=ja
# WEREWOLF_STREAMLIT_I18N_FILE=definitions/streamlit/i18n.toml
# WEREWOLF_STREAMLIT_CSS_FILE=definitions/streamlit/default.css
# WEREWOLF_STREAMLIT_SCREENS_FILE=definitions/streamlit/screens.toml
# WEREWOLF_STREAMLIT_RANDOM_SEED_MAX=1000000
# WEREWOLF_API_GAME_LIST_DEFAULT_LIMIT=20
# WEREWOLF_API_GAME_LIST_MAX_LIMIT=100
# WEREWOLF_API_TIMELINE_DEFAULT_LIMIT=100
# WEREWOLF_API_TIMELINE_MAX_LIMIT=500
# WEREWOLF_GAME_DEFAULT_NARRATION_MODE=standard

# Supabase client settings. UI/CLI use only URL + publishable key.
# Leave blank to run unauthenticated in-process demo mode.
# WEREWOLF_SUPABASE_URL=http://127.0.0.1:54321
# WEREWOLF_SUPABASE_PUBLISHABLE_KEY=
# WEREWOLF_SUPABASE_AUTH_TIMEOUT_SECONDS=10
# WEREWOLF_SUPABASE_REST_TIMEOUT_SECONDS=10

# Supabase worker-only secret. Never expose this to Streamlit, CLI, or browser clients.
# Local Supabase default shape:
# postgresql://postgres:postgres@127.0.0.1:54322/postgres
# WEREWOLF_SUPABASE_DB_DSN=
# WEREWOLF_SUPABASE_WORKER_ID=worker-default
# WEREWOLF_SUPABASE_WORKER_POLL_INTERVAL_SECONDS=1
# WEREWOLF_SUPABASE_WORKER_BATCH_SIZE=5
# WEREWOLF_SUPABASE_WORKER_CLAIM_SECONDS=60
# WEREWOLF_LLM_TRACE_RETENTION_DAYS=30

# Definition resource overrides. Leave blank to use packaged defaults.
# WEREWOLF_GAME_RULES_FILE=definitions/game/rules.toml
# WEREWOLF_GAME_ROLES_FILE=definitions/game/roles.toml
# WEREWOLF_GAME_CATALOG_FILE=definitions/game/catalog.toml
# WEREWOLF_LLM_PLAYERS_FILE=definitions/llm/players.toml
# WEREWOLF_LLM_PROMPT_FILE=definitions/llm/agent_decision.toml
# WEREWOLF_LLM_FAKE_RESPONSES_FILE=definitions/llm/fake_responses.toml
# WEREWOLF_LLM_DECISION_GRAPHS_FILE=definitions/llm/decision_graphs.toml

# LLM provider overrides. Packaged defaults use FakeListLLM and do not require network.
# WEREWOLF_LLM_PROVIDER=fake
# WEREWOLF_MODEL=fake-list-llm
# WEREWOLF_LLM_BASE_URL=
# WEREWOLF_LLM_TIMEOUT_SECONDS=12
# WEREWOLF_LLM_MAX_RETRIES=0
# WEREWOLF_LLM_MAX_TOKENS=96
# WEREWOLF_LLM_TEMPERATURE=0.7
# WEREWOLF_LLM_DEFAULT_AGENT_STRATEGY_ID=stable_fast
# WEREWOLF_LLM_STRUCTURED_OUTPUT_MODE=auto
# WEREWOLF_LLM_VALIDATION_RETRY_COUNT=1
# WEREWOLF_LLM_GRAPH_MAX_STEPS=8
# WEREWOLF_LLM_FALLBACK_POLICY=deterministic_legal_action

# LM Studio: start the local server, then use auto to select the first loaded model.
# WEREWOLF_LLM_PROVIDER=lmstudio
# WEREWOLF_MODEL=auto
# WEREWOLF_LLM_BASE_URL=http://127.0.0.1:1234/v1

# OpenAI: set provider/model/API key. Leave base URL blank for the official endpoint.
# WEREWOLF_LLM_PROVIDER=openai
# WEREWOLF_MODEL=gpt-4.1-mini
# WEREWOLF_LLM_BASE_URL=

# Real provider keys must stay out of Git. Leave example values blank.
OPENAI_API_KEY=
