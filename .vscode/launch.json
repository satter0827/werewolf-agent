{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Internal: Supabase Stack",
      "type": "debugpy",
      "request": "launch",
      "module": "scripts.supabase",
      "args": ["serve", "--stop-on-exit"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "postDebugTask": "Internal: Supabase Stop",
      "presentation": { "hidden": true }
    },
    {
      "name": "API",
      "type": "debugpy",
      "request": "launch",
      "preLaunchTask": "Internal: Ensure Check",
      "module": "werewolf_agent.api.app",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "WEREWOLF_LOG_FILE_NAME": "api.jsonl"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Worker",
      "type": "debugpy",
      "request": "launch",
      "preLaunchTask": "Internal: Ensure Check",
      "module": "werewolf_agent.worker.app",
      "args": ["run"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "WEREWOLF_LOG_FILE_NAME": "worker.jsonl"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "React",
      "type": "pwa-chrome",
      "request": "launch",
      "preLaunchTask": "Internal: Frontend Dev",
      "url": "http://127.0.0.1:5173",
      "webRoot": "${workspaceFolder}/frontend/src"
    },
    {
      "name": "Streamlit",
      "type": "debugpy",
      "request": "launch",
      "preLaunchTask": "Internal: Ensure Check",
      "module": "streamlit",
      "args": [
        "run",
        "src/werewolf_agent/clients/streamlit/app.py",
        "--server.address",
        "127.0.0.1",
        "--server.headless",
        "true",
        "--browser.gatherUsageStats",
        "false"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "WEREWOLF_LOG_FILE_NAME": "streamlit.jsonl"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "CLI Doctor",
      "type": "debugpy",
      "request": "launch",
      "preLaunchTask": "Internal: Ensure Check",
      "module": "werewolf_agent",
      "args": ["doctor"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    },
    {
      "name": "CLI Play",
      "type": "debugpy",
      "request": "launch",
      "preLaunchTask": "Internal: Ensure Check",
      "module": "werewolf_agent",
      "args": [
        "play",
        "--role-count",
        "werewolf=1",
        "--role-count",
        "seer=1",
        "--role-count",
        "knight=1",
        "--role-count",
        "villager=3",
        "--seed",
        "1"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "React Stack",
      "configurations": ["Internal: Supabase Stack", "API", "Worker", "React"],
      "preLaunchTask": "Internal: Supabase Preflight",
      "stopAll": true
    },
    {
      "name": "Streamlit Stack",
      "configurations": ["Internal: Supabase Stack", "API", "Worker", "Streamlit"],
      "preLaunchTask": "Internal: Supabase Preflight",
      "stopAll": true
    }
  ]
}
