{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend/src"
      },
      "justMyCode": true
    },
    {
      "name": "Werewolf Agent: Doctor",
      "type": "debugpy",
      "request": "launch",
      "module": "werewolf_agent.interfaces.cli",
      "args": ["doctor"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend/src"
      },
      "justMyCode": true
    },
    {
      "name": "Django API: Runserver",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/manage.py",
      "args": ["runserver", "127.0.0.1:8000"],
      "django": true,
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend/src",
        "DJANGO_SETTINGS_MODULE": "werewolf_agent.interfaces.api.config.settings"
      },
      "justMyCode": true
    },
    {
      "name": "Tests: Pytest",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend/src"
      },
      "justMyCode": true
    }
  ]
}
