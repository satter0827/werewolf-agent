{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "内部: Supabase",
      "type": "debugpy",
      "request": "launch",
      "module": "scripts.supabase",
      "args": ["serve", "--reserved", "--stop-on-exit"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "presentation": { "hidden": true }
    },
    {
      "name": "内部: API",
      "type": "debugpy",
      "request": "launch",
      "preLaunchTask": "内部: Supabaseの準備完了を待つ",
      "module": "werewolf_agent.api.app",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true,
      "presentation": { "hidden": true }
    },
    {
      "name": "内部: Worker",
      "type": "debugpy",
      "request": "launch",
      "preLaunchTask": "内部: Supabaseの準備完了を待つ",
      "module": "werewolf_agent.worker.app",
      "args": ["run"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "presentation": { "hidden": true }
    },
    {
      "name": "内部: Full Stack Streamlit",
      "type": "debugpy",
      "request": "launch",
      "preLaunchTask": "内部: Supabaseの準備完了を待つ",
      "module": "streamlit",
      "args": ["run", "src/werewolf_agent/clients/streamlit/app.py"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "(?:Local )?URL: (https?://[^\\s]+)",
        "uriFormat": "%s",
        "action": "openExternally"
      },
      "presentation": { "hidden": true }
    },
    {
      "name": "クライアント: Streamlit",
      "type": "debugpy",
      "request": "launch",
      "preLaunchTask": "内部: Python環境を確認",
      "module": "streamlit",
      "args": ["run", "src/werewolf_agent/clients/streamlit/app.py"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "(?:Local )?URL: (https?://[^\\s]+)",
        "uriFormat": "%s",
        "action": "openExternally"
      },
      "presentation": { "group": "クライアント", "order": 1 }
    },
    {
      "name": "クライアント: CLI Play",
      "type": "debugpy",
      "request": "launch",
      "preLaunchTask": "内部: Python環境を確認",
      "module": "werewolf_agent",
      "args": [
        "play",
        "--role-count", "werewolf=1",
        "--role-count", "seer=1",
        "--role-count", "knight=1",
        "--role-count", "villager=3",
        "--seed", "1"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "presentation": { "group": "クライアント", "order": 2 }
    }
  ],
  "compounds": [
    {
      "name": "開発: Full Stack",
      "configurations": ["内部: Supabase", "内部: API", "内部: Worker", "内部: Full Stack Streamlit"],
      "preLaunchTask": "内部: Full Stackを予約",
      "stopAll": true,
      "presentation": { "group": "開発", "order": 1 }
    },
    {
      "name": "開発: Backend",
      "configurations": ["内部: Supabase", "内部: API", "内部: Worker"],
      "preLaunchTask": "内部: Backendを予約",
      "stopAll": true,
      "presentation": { "group": "開発", "order": 2 }
    },
    {
      "name": "デバッグ: API",
      "configurations": ["内部: Supabase", "内部: API"],
      "preLaunchTask": "内部: APIを予約",
      "stopAll": true,
      "presentation": { "group": "デバッグ", "order": 1 }
    },
    {
      "name": "デバッグ: Worker",
      "configurations": ["内部: Supabase", "内部: Worker"],
      "preLaunchTask": "内部: Workerを予約",
      "stopAll": true,
      "presentation": { "group": "デバッグ", "order": 2 }
    }
  ]
}
