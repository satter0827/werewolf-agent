{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "CLI: doctor",
      "type": "debugpy",
      "request": "launch",
      "module": "werewolf_agent",
      "args": ["doctor"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend/src",
        "WEREWOLF_LOG_LEVEL": "DEBUG",
        "WEREWOLF_LOG_OUTPUT": "both",
        "WEREWOLF_LOG_DIR": "${env:TEMP}\\werewolf-agent\\logs",
        "WEREWOLF_LOG_FILE_NAME": "vscode-cli.jsonl",
        "WEREWOLF_LOG_THIRD_PARTY_LEVEL": "INFO"
      },
      "justMyCode": true
    },
    {
      "name": "CLI: ruleset",
      "type": "debugpy",
      "request": "launch",
      "module": "werewolf_agent",
      "args": [
        "ruleset",
        "--api-url",
        "http://127.0.0.1:8000/api/v1"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend/src",
        "WEREWOLF_LOG_LEVEL": "DEBUG",
        "WEREWOLF_LOG_OUTPUT": "both",
        "WEREWOLF_LOG_DIR": "${env:TEMP}\\werewolf-agent\\logs",
        "WEREWOLF_LOG_FILE_NAME": "vscode-cli.jsonl",
        "WEREWOLF_LOG_THIRD_PARTY_LEVEL": "INFO"
      },
      "justMyCode": true
    },
    {
      "name": "API: migrate",
      "type": "debugpy",
      "request": "launch",
      "module": "alembic",
      "args": ["upgrade", "head"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend/src",
        "WEREWOLF_LOG_LEVEL": "DEBUG",
        "WEREWOLF_LOG_OUTPUT": "both",
        "WEREWOLF_LOG_DIR": "${env:TEMP}\\werewolf-agent\\logs",
        "WEREWOLF_LOG_FILE_NAME": "vscode-migrate.jsonl",
        "WEREWOLF_LOG_THIRD_PARTY_LEVEL": "INFO",
        "WEREWOLF_SQLITE_PATH": "${env:TEMP}\\werewolf-agent\\db\\vscode.sqlite3"
      },
      "justMyCode": true
    },
    {
      "name": "API: uvicorn",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "werewolf_agent.interface.api.app:create_app",
        "--factory",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend/src",
        "WEREWOLF_LOG_LEVEL": "DEBUG",
        "WEREWOLF_LOG_OUTPUT": "both",
        "WEREWOLF_LOG_DIR": "${env:TEMP}\\werewolf-agent\\logs",
        "WEREWOLF_LOG_FILE_NAME": "vscode-api.jsonl",
        "WEREWOLF_LOG_THIRD_PARTY_LEVEL": "INFO",
        "WEREWOLF_SQLITE_PATH": "${env:TEMP}\\werewolf-agent\\db\\vscode.sqlite3"
      },
      "justMyCode": true
    },
    {
      "name": "UI: Streamlit",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": [
        "run",
        "backend/src/werewolf_agent/interface/entrypoint/streamlit/app.py",
        "--server.headless=true",
        "--server.port",
        "${input:streamlitPort}",
        "--browser.gatherUsageStats=false"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend/src",
        "WEREWOLF_LOG_LEVEL": "DEBUG",
        "WEREWOLF_LOG_OUTPUT": "both",
        "WEREWOLF_LOG_DIR": "${env:TEMP}\\werewolf-agent\\logs",
        "WEREWOLF_LOG_FILE_NAME": "vscode-streamlit.jsonl",
        "WEREWOLF_LOG_THIRD_PARTY_LEVEL": "INFO",
        "WEREWOLF_STREAMLIT_API_URL": "http://127.0.0.1:8000/api/v1",
        "WEREWOLF_STREAMLIT_SAVE_FILE": "${env:TEMP}\\werewolf-agent\\streamlit\\saves.json"
      },
      "justMyCode": true
    },
    {
      "name": "CLI: create",
      "type": "debugpy",
      "request": "launch",
      "module": "werewolf_agent",
      "args": [
        "create",
        "--api-url",
        "http://127.0.0.1:8000/api/v1",
        "--players",
        "6",
        "--seed",
        "1"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend/src",
        "WEREWOLF_LOG_LEVEL": "DEBUG",
        "WEREWOLF_LOG_OUTPUT": "both",
        "WEREWOLF_LOG_DIR": "${env:TEMP}\\werewolf-agent\\logs",
        "WEREWOLF_LOG_FILE_NAME": "vscode-cli.jsonl",
        "WEREWOLF_LOG_THIRD_PARTY_LEVEL": "INFO"
      },
      "justMyCode": true
    },
    {
      "name": "CLI: state",
      "type": "debugpy",
      "request": "launch",
      "module": "werewolf_agent",
      "args": [
        "state",
        "${input:gameId}",
        "--api-url",
        "http://127.0.0.1:8000/api/v1"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend/src",
        "WEREWOLF_LOG_LEVEL": "DEBUG",
        "WEREWOLF_LOG_OUTPUT": "both",
        "WEREWOLF_LOG_DIR": "${env:TEMP}\\werewolf-agent\\logs",
        "WEREWOLF_LOG_FILE_NAME": "vscode-cli.jsonl",
        "WEREWOLF_LOG_THIRD_PARTY_LEVEL": "INFO"
      },
      "justMyCode": true
    },
    {
      "name": "CLI: step",
      "type": "debugpy",
      "request": "launch",
      "module": "werewolf_agent",
      "args": [
        "step",
        "${input:gameId}",
        "--api-url",
        "http://127.0.0.1:8000/api/v1"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend/src",
        "WEREWOLF_LOG_LEVEL": "DEBUG",
        "WEREWOLF_LOG_OUTPUT": "both",
        "WEREWOLF_LOG_DIR": "${env:TEMP}\\werewolf-agent\\logs",
        "WEREWOLF_LOG_FILE_NAME": "vscode-cli.jsonl",
        "WEREWOLF_LOG_THIRD_PARTY_LEVEL": "INFO"
      },
      "justMyCode": true
    },
    {
      "name": "CLI: play",
      "type": "debugpy",
      "request": "launch",
      "module": "werewolf_agent",
      "args": [
        "play",
        "--api-url",
        "http://127.0.0.1:8000/api/v1",
        "--players",
        "6",
        "--seed",
        "1"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend/src",
        "WEREWOLF_LOG_LEVEL": "DEBUG",
        "WEREWOLF_LOG_OUTPUT": "both",
        "WEREWOLF_LOG_DIR": "${env:TEMP}\\werewolf-agent\\logs",
        "WEREWOLF_LOG_FILE_NAME": "vscode-cli.jsonl",
        "WEREWOLF_LOG_THIRD_PARTY_LEVEL": "INFO"
      },
      "justMyCode": true
    },
    {
      "name": "CLI: play (human player)",
      "type": "debugpy",
      "request": "launch",
      "module": "werewolf_agent",
      "args": [
        "play",
        "--api-url",
        "http://127.0.0.1:8000/api/v1",
        "--players",
        "6",
        "--seed",
        "1",
        "--human-player",
        "player-1"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend/src",
        "WEREWOLF_LOG_LEVEL": "DEBUG",
        "WEREWOLF_LOG_OUTPUT": "both",
        "WEREWOLF_LOG_DIR": "${env:TEMP}\\werewolf-agent\\logs",
        "WEREWOLF_LOG_FILE_NAME": "vscode-cli.jsonl",
        "WEREWOLF_LOG_THIRD_PARTY_LEVEL": "INFO"
      },
      "justMyCode": true
    },
    {
      "name": "CLI: play (save replay log)",
      "type": "debugpy",
      "request": "launch",
      "module": "werewolf_agent",
      "args": [
        "play",
        "--api-url",
        "http://127.0.0.1:8000/api/v1",
        "--players",
        "6",
        "--seed",
        "1",
        "--log-jsonl",
        "${input:eventLogPath}"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend/src",
        "WEREWOLF_LOG_LEVEL": "DEBUG",
        "WEREWOLF_LOG_OUTPUT": "both",
        "WEREWOLF_LOG_DIR": "${env:TEMP}\\werewolf-agent\\logs",
        "WEREWOLF_LOG_FILE_NAME": "vscode-cli.jsonl",
        "WEREWOLF_LOG_THIRD_PARTY_LEVEL": "INFO"
      },
      "justMyCode": true
    },
    {
      "name": "CLI: runs",
      "type": "debugpy",
      "request": "launch",
      "module": "werewolf_agent",
      "args": [
        "runs",
        "--api-url",
        "http://127.0.0.1:8000/api/v1"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend/src",
        "WEREWOLF_LOG_LEVEL": "DEBUG",
        "WEREWOLF_LOG_OUTPUT": "both",
        "WEREWOLF_LOG_DIR": "${env:TEMP}\\werewolf-agent\\logs",
        "WEREWOLF_LOG_FILE_NAME": "vscode-cli.jsonl",
        "WEREWOLF_LOG_THIRD_PARTY_LEVEL": "INFO"
      },
      "justMyCode": true
    },
    {
      "name": "CLI: watch",
      "type": "debugpy",
      "request": "launch",
      "module": "werewolf_agent",
      "args": [
        "watch",
        "${input:gameId}",
        "--api-url",
        "http://127.0.0.1:8000/api/v1"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend/src",
        "WEREWOLF_LOG_LEVEL": "DEBUG",
        "WEREWOLF_LOG_OUTPUT": "both",
        "WEREWOLF_LOG_DIR": "${env:TEMP}\\werewolf-agent\\logs",
        "WEREWOLF_LOG_FILE_NAME": "vscode-cli.jsonl",
        "WEREWOLF_LOG_THIRD_PARTY_LEVEL": "INFO"
      },
      "justMyCode": true
    },
    {
      "name": "CLI: turns",
      "type": "debugpy",
      "request": "launch",
      "module": "werewolf_agent",
      "args": [
        "turns",
        "${input:gameId}",
        "--api-url",
        "http://127.0.0.1:8000/api/v1"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend/src",
        "WEREWOLF_LOG_LEVEL": "DEBUG",
        "WEREWOLF_LOG_OUTPUT": "both",
        "WEREWOLF_LOG_DIR": "${env:TEMP}\\werewolf-agent\\logs",
        "WEREWOLF_LOG_FILE_NAME": "vscode-cli.jsonl",
        "WEREWOLF_LOG_THIRD_PARTY_LEVEL": "INFO"
      },
      "justMyCode": true
    },
    {
      "name": "CLI: replay",
      "type": "debugpy",
      "request": "launch",
      "module": "werewolf_agent",
      "args": [
        "replay",
        "--events",
        "${input:eventLogPath}"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend/src",
        "WEREWOLF_LOG_LEVEL": "DEBUG",
        "WEREWOLF_LOG_OUTPUT": "both",
        "WEREWOLF_LOG_DIR": "${env:TEMP}\\werewolf-agent\\logs",
        "WEREWOLF_LOG_FILE_NAME": "vscode-cli.jsonl",
        "WEREWOLF_LOG_THIRD_PARTY_LEVEL": "INFO"
      },
      "justMyCode": true
    },
    {
      "name": "Pytest: all tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend/src"
      },
      "justMyCode": true
    },
    {
      "name": "Pytest: API integration",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests/integration/api"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend/src"
      },
      "justMyCode": true
    },
    {
      "name": "Pytest: current file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend/src"
      },
      "justMyCode": true
    }
  ],
  "compounds": [
    {
      "name": "App: API + Streamlit",
      "configurations": ["API: uvicorn", "UI: Streamlit"],
      "preLaunchTask": "API: migrate (python -m alembic)",
      "stopAll": true
    }
  ],
  "inputs": [
    {
      "id": "gameId",
      "type": "promptString",
      "description": "Game ID for CLI state / step / watch / turns",
      "default": ""
    },
    {
      "id": "eventLogPath",
      "type": "promptString",
      "description": "Public event JSONL path for CLI replay",
      "default": ".werewolf-agent/logs/game-001.jsonl"
    },
    {
      "id": "streamlitPort",
      "type": "promptString",
      "description": "Streamlit port",
      "default": "8501"
    }
  ]
}
