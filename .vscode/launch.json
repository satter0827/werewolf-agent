{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Quality: Quick",
      "type": "debugpy",
      "request": "launch",
      "module": "scripts.quality",
      "args": ["quick"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Quality: Check",
      "type": "debugpy",
      "request": "launch",
      "module": "scripts.quality",
      "args": ["check"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Quality: Release",
      "type": "debugpy",
      "request": "launch",
      "module": "scripts.quality",
      "args": ["release"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Quality: Deep (Confirmation Required)",
      "type": "debugpy",
      "request": "launch",
      "module": "scripts.quality",
      "args": ["deep", "--confirm-deep"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Tests: Current File (Quick)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["--test-level=quick", "-n", "0", "${file}"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Service: API",
      "type": "debugpy",
      "request": "launch",
      "module": "werewolf_agent.api.app",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "WEREWOLF_LOG_FILE_NAME": "api.jsonl"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Service: Streamlit",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": [
        "run",
        "src/werewolf_agent/interfaces/streamlit/app.py",
        "--server.address",
        "127.0.0.1",
        "--server.headless",
        "true",
        "--browser.gatherUsageStats",
        "false"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "WEREWOLF_LOG_FILE_NAME": "streamlit.jsonl"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Service: Worker",
      "type": "debugpy",
      "request": "launch",
      "module": "werewolf_agent.interfaces.worker.app",
      "args": ["run"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "WEREWOLF_LOG_FILE_NAME": "worker.jsonl"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "CLI: Doctor",
      "type": "debugpy",
      "request": "launch",
      "module": "werewolf_agent",
      "args": ["doctor"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    },
    {
      "name": "CLI: Play",
      "type": "debugpy",
      "request": "launch",
      "module": "werewolf_agent",
      "args": [
        "play",
        "--role-count",
        "werewolf=1",
        "--role-count",
        "seer=1",
        "--role-count",
        "knight=1",
        "--role-count",
        "villager=3",
        "--seed",
        "1"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    },
    {
      "name": "CLI: Play as Manual Player",
      "type": "debugpy",
      "request": "launch",
      "module": "werewolf_agent",
      "args": [
        "play",
        "--role-count",
        "werewolf=1",
        "--role-count",
        "seer=1",
        "--role-count",
        "knight=1",
        "--role-count",
        "villager=3",
        "--seed",
        "1",
        "--manual-player",
        "player-1"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "App: Streamlit, API, and Worker",
      "configurations": ["Service: API", "Service: Worker", "Service: Streamlit"],
      "preLaunchTask": "Supabase: Preflight",
      "stopAll": true
    }
  ]
}
