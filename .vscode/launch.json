{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "CLI: doctor",
      "type": "debugpy",
      "request": "launch",
      "module": "werewolf_agent",
      "args": [
        "doctor"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend/src",
        "WEREWOLF_LOG_FILE_NAME": "cli.jsonl"
      },
      "justMyCode": true
    },
    {
      "name": "CLI: setup-options",
      "type": "debugpy",
      "request": "launch",
      "module": "werewolf_agent",
      "args": [
        "setup-options"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend/src",
        "WEREWOLF_LOG_FILE_NAME": "cli.jsonl"
      },
      "justMyCode": true
    },
    {
      "name": "API: uvicorn",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "werewolf_agent.interface.api.app:create_app",
        "--factory",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend/src",
        "WEREWOLF_LOG_FILE_NAME": "api.jsonl"
      },
      "justMyCode": true
    },
    {
      "name": "Worker: run",
      "type": "debugpy",
      "request": "launch",
      "module": "werewolf_agent.interface.entrypoint.worker.app",
      "args": [
        "run"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend/src",
        "WEREWOLF_LOG_FILE_NAME": "worker.jsonl"
      },
      "justMyCode": true
    },
    {
      "name": "UI: Streamlit",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": [
        "run",
        "backend/src/werewolf_agent/interface/entrypoint/streamlit/app.py",
        "--server.headless=true",
        "--server.port",
        "${input:streamlitPort}",
        "--browser.gatherUsageStats=false"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend/src",
        "WEREWOLF_LOG_FILE_NAME": "streamlit.jsonl"
      },
      "justMyCode": true
    },
    {
      "name": "CLI: new",
      "type": "debugpy",
      "request": "launch",
      "module": "werewolf_agent",
      "args": [
        "new",
        "--role-count",
        "werewolf=1",
        "--role-count",
        "seer=1",
        "--role-count",
        "knight=1",
        "--role-count",
        "villager=3",
        "--seed",
        "1"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend/src",
        "WEREWOLF_LOG_FILE_NAME": "cli.jsonl"
      },
      "justMyCode": true
    },
    {
      "name": "CLI: show",
      "type": "debugpy",
      "request": "launch",
      "module": "werewolf_agent",
      "args": [
        "show",
        "${input:gameId}"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend/src",
        "WEREWOLF_LOG_FILE_NAME": "cli.jsonl"
      },
      "justMyCode": true
    },
    {
      "name": "CLI: advance",
      "type": "debugpy",
      "request": "launch",
      "module": "werewolf_agent",
      "args": [
        "advance",
        "${input:gameId}"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend/src",
        "WEREWOLF_LOG_FILE_NAME": "cli.jsonl"
      },
      "justMyCode": true
    },
    {
      "name": "CLI: play",
      "type": "debugpy",
      "request": "launch",
      "module": "werewolf_agent",
      "args": [
        "play",
        "--role-count",
        "werewolf=1",
        "--role-count",
        "seer=1",
        "--role-count",
        "knight=1",
        "--role-count",
        "villager=3",
        "--seed",
        "1"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend/src",
        "WEREWOLF_LOG_FILE_NAME": "cli.jsonl"
      },
      "justMyCode": true
    },
    {
      "name": "CLI: play (manual player)",
      "type": "debugpy",
      "request": "launch",
      "module": "werewolf_agent",
      "args": [
        "play",
        "--role-count",
        "werewolf=1",
        "--role-count",
        "seer=1",
        "--role-count",
        "knight=1",
        "--role-count",
        "villager=3",
        "--seed",
        "1",
        "--manual-player",
        "player-1"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend/src",
        "WEREWOLF_LOG_FILE_NAME": "cli.jsonl"
      },
      "justMyCode": true
    },
    {
      "name": "CLI: play (save replay log)",
      "type": "debugpy",
      "request": "launch",
      "module": "werewolf_agent",
      "args": [
        "play",
        "--role-count",
        "werewolf=1",
        "--role-count",
        "seer=1",
        "--role-count",
        "knight=1",
        "--role-count",
        "villager=3",
        "--seed",
        "1",
        "--log-jsonl",
        "${input:timelineLogPath}"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend/src",
        "WEREWOLF_LOG_FILE_NAME": "cli.jsonl"
      },
      "justMyCode": true
    },
    {
      "name": "CLI: games",
      "type": "debugpy",
      "request": "launch",
      "module": "werewolf_agent",
      "args": [
        "games"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend/src",
        "WEREWOLF_LOG_FILE_NAME": "cli.jsonl"
      },
      "justMyCode": true
    },
    {
      "name": "CLI: timeline",
      "type": "debugpy",
      "request": "launch",
      "module": "werewolf_agent",
      "args": [
        "timeline",
        "${input:gameId}"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend/src",
        "WEREWOLF_LOG_FILE_NAME": "cli.jsonl"
      },
      "justMyCode": true
    },
    {
      "name": "CLI: replay",
      "type": "debugpy",
      "request": "launch",
      "module": "werewolf_agent",
      "args": [
        "replay",
        "--timeline",
        "${input:timelineLogPath}"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend/src",
        "WEREWOLF_LOG_FILE_NAME": "cli.jsonl"
      },
      "justMyCode": true
    },
    {
      "name": "Pytest: all tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "tests"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend/src"
      },
      "justMyCode": true
    },
    {
      "name": "Pytest: API integration",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "tests/integration/api"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend/src"
      },
      "justMyCode": true
    },
    {
      "name": "Pytest: current file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "${file}"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend/src"
      },
      "justMyCode": true
    }
  ],
  "compounds": [
    {
      "name": "App: API + Streamlit",
      "configurations": [
        "API: uvicorn",
        "UI: Streamlit"
      ],
      "stopAll": true
    }
  ],
  "inputs": [
    {
      "id": "gameId",
      "type": "promptString",
      "description": "Game ID for CLI show / advance / timeline",
      "default": ""
    },
    {
      "id": "timelineLogPath",
      "type": "promptString",
      "description": "Public timeline JSONL path for CLI replay",
      "default": ".werewolf-agent/logs/game-001.jsonl"
    },
    {
      "id": "streamlitPort",
      "type": "promptString",
      "description": "Streamlit port",
      "default": "8501"
    }
  ]
}
