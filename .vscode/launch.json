{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "CLI: doctor",
      "type": "debugpy",
      "request": "launch",
      "module": "werewolf_agent",
      "args": ["doctor"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend/src"
      },
      "justMyCode": true
    },
    {
      "name": "API: migrate",
      "type": "debugpy",
      "request": "launch",
      "module": "alembic",
      "args": ["upgrade", "head"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend/src"
      },
      "justMyCode": true
    },
    {
      "name": "API: runserver",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "werewolf_agent.interface.entrypoint.api.app:create_app",
        "--factory",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend/src"
      },
      "justMyCode": true
    },
    {
      "name": "CLI: play",
      "type": "debugpy",
      "request": "launch",
      "module": "werewolf_agent",
      "args": [
        "play",
        "--api-url",
        "http://127.0.0.1:8000/api/v1",
        "--players",
        "6",
        "--seed",
        "1"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend/src"
      },
      "justMyCode": true
    },
    {
      "name": "CLI: runs",
      "type": "debugpy",
      "request": "launch",
      "module": "werewolf_agent",
      "args": [
        "runs",
        "--api-url",
        "http://127.0.0.1:8000/api/v1"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend/src"
      },
      "justMyCode": true
    },
    {
      "name": "CLI: watch",
      "type": "debugpy",
      "request": "launch",
      "module": "werewolf_agent",
      "args": [
        "watch",
        "${input:gameId}",
        "--api-url",
        "http://127.0.0.1:8000/api/v1"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend/src"
      },
      "justMyCode": true
    },
    {
      "name": "CLI: turns",
      "type": "debugpy",
      "request": "launch",
      "module": "werewolf_agent",
      "args": [
        "turns",
        "${input:gameId}",
        "--api-url",
        "http://127.0.0.1:8000/api/v1"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend/src"
      },
      "justMyCode": true
    },
    {
      "name": "Pytest: all tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend/src"
      },
      "justMyCode": true
    },
    {
      "name": "Pytest: API integration",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests/integration/api"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend/src"
      },
      "justMyCode": true
    },
    {
      "name": "Pytest: current file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend/src"
      },
      "justMyCode": true
    }
  ],
  "inputs": [
    {
      "id": "gameId",
      "type": "promptString",
      "description": "Game ID for CLI watch / turns",
      "default": ""
    }
  ]
}
