{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Internal: Streamlit",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": [
        "run",
        "src/werewolf_agent/interfaces/streamlit/app.py",
        "--server.address",
        "127.0.0.1",
        "--server.port",
        "8501",
        "--server.headless",
        "true",
        "--browser.gatherUsageStats",
        "false"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "WEREWOLF_LOG_FILE_NAME": "streamlit.jsonl"
      },
      "presentation": {
        "hidden": true
      },
      "justMyCode": true
    },
    {
      "name": "Internal: Worker",
      "type": "debugpy",
      "request": "launch",
      "module": "werewolf_agent.interfaces.worker.app",
      "args": [
        "run"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "WEREWOLF_LOG_FILE_NAME": "worker.jsonl"
      },
      "presentation": {
        "hidden": true
      },
      "justMyCode": true
    },
    {
      "name": "Internal: Worker once",
      "type": "debugpy",
      "request": "launch",
      "module": "werewolf_agent.interfaces.worker.app",
      "args": [
        "once"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "WEREWOLF_LOG_FILE_NAME": "worker.jsonl"
      },
      "presentation": {
        "hidden": true
      },
      "justMyCode": true
    },
    {
      "name": "CLI: doctor",
      "type": "debugpy",
      "request": "launch",
      "module": "werewolf_agent",
      "args": [
        "doctor"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "WEREWOLF_LOG_FILE_NAME": "cli.jsonl"
      },
      "justMyCode": true
    },
    {
      "name": "CLI: setup-options",
      "type": "debugpy",
      "request": "launch",
      "module": "werewolf_agent",
      "args": [
        "setup-options"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "WEREWOLF_LOG_FILE_NAME": "cli.jsonl"
      },
      "justMyCode": true
    },
    {
      "name": "CLI: new",
      "type": "debugpy",
      "request": "launch",
      "module": "werewolf_agent",
      "args": [
        "new",
        "--role-count",
        "werewolf=1",
        "--role-count",
        "seer=1",
        "--role-count",
        "knight=1",
        "--role-count",
        "villager=3",
        "--seed",
        "1"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "WEREWOLF_LOG_FILE_NAME": "cli.jsonl"
      },
      "justMyCode": true
    },
    {
      "name": "CLI: play",
      "type": "debugpy",
      "request": "launch",
      "module": "werewolf_agent",
      "args": [
        "play",
        "--role-count",
        "werewolf=1",
        "--role-count",
        "seer=1",
        "--role-count",
        "knight=1",
        "--role-count",
        "villager=3",
        "--seed",
        "1"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "WEREWOLF_LOG_FILE_NAME": "cli.jsonl"
      },
      "justMyCode": true
    },
    {
      "name": "CLI: play (manual player)",
      "type": "debugpy",
      "request": "launch",
      "module": "werewolf_agent",
      "args": [
        "play",
        "--role-count",
        "werewolf=1",
        "--role-count",
        "seer=1",
        "--role-count",
        "knight=1",
        "--role-count",
        "villager=3",
        "--seed",
        "1",
        "--manual-player",
        "player-1"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "WEREWOLF_LOG_FILE_NAME": "cli.jsonl"
      },
      "justMyCode": true
    },
    {
      "name": "CLI: play (save replay log)",
      "type": "debugpy",
      "request": "launch",
      "module": "werewolf_agent",
      "args": [
        "play",
        "--role-count",
        "werewolf=1",
        "--role-count",
        "seer=1",
        "--role-count",
        "knight=1",
        "--role-count",
        "villager=3",
        "--seed",
        "1",
        "--log-jsonl",
        "${input:timelineLogPath}"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "WEREWOLF_LOG_FILE_NAME": "cli.jsonl"
      },
      "justMyCode": true
    },
    {
      "name": "CLI: games",
      "type": "debugpy",
      "request": "launch",
      "module": "werewolf_agent",
      "args": [
        "games"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "WEREWOLF_LOG_FILE_NAME": "cli.jsonl"
      },
      "justMyCode": true
    },
    {
      "name": "CLI: show",
      "type": "debugpy",
      "request": "launch",
      "module": "werewolf_agent",
      "args": [
        "show",
        "${input:gameId}"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "WEREWOLF_LOG_FILE_NAME": "cli.jsonl"
      },
      "justMyCode": true
    },
    {
      "name": "CLI: advance",
      "type": "debugpy",
      "request": "launch",
      "module": "werewolf_agent",
      "args": [
        "advance",
        "${input:gameId}"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "WEREWOLF_LOG_FILE_NAME": "cli.jsonl"
      },
      "justMyCode": true
    },
    {
      "name": "CLI: timeline",
      "type": "debugpy",
      "request": "launch",
      "module": "werewolf_agent",
      "args": [
        "timeline",
        "${input:gameId}"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "WEREWOLF_LOG_FILE_NAME": "cli.jsonl"
      },
      "justMyCode": true
    },
    {
      "name": "CLI: timeline (follow)",
      "type": "debugpy",
      "request": "launch",
      "module": "werewolf_agent",
      "args": [
        "timeline",
        "${input:gameId}",
        "--follow"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "WEREWOLF_LOG_FILE_NAME": "cli.jsonl"
      },
      "justMyCode": true
    },
    {
      "name": "CLI: replay",
      "type": "debugpy",
      "request": "launch",
      "module": "werewolf_agent",
      "args": [
        "replay",
        "--timeline",
        "${input:timelineLogPath}"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "WEREWOLF_LOG_FILE_NAME": "cli.jsonl"
      },
      "justMyCode": true
    },
    {
      "name": "Pytest: all tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "-o",
        "cache_dir=${env:TEMP}\\werewolf-agent\\cache\\pytest",
        "tests"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "justMyCode": true
    },
    {
      "name": "Pytest: current file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "-o",
        "cache_dir=${env:TEMP}\\werewolf-agent\\cache\\pytest",
        "${file}"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "justMyCode": true
    }
  ],
  "compounds": [
    {
      "name": "UI: Streamlit (verified)",
      "configurations": [
        "Internal: Worker",
        "Internal: Streamlit"
      ],
      "preLaunchTask": "Supabase: preflight",
      "stopAll": true
    }
  ],
  "inputs": [
    {
      "id": "gameId",
      "type": "promptString",
      "description": "Game ID for CLI show / advance / timeline",
      "default": ""
    },
    {
      "id": "timelineLogPath",
      "type": "promptString",
      "description": "Public timeline JSONL path for CLI replay",
      "default": ".werewolf-agent/logs/game-001.jsonl"
    }
  ]
}
