{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Internal: Supabase Stack",
      "type": "debugpy",
      "request": "launch",
      "module": "scripts.supabase",
      "args": ["serve", "--stop-on-exit"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "postDebugTask": "Internal: Supabase Stop",
      "presentation": { "hidden": true }
    },
    {
      "name": "Debug: API",
      "type": "debugpy",
      "request": "launch",
      "preLaunchTask": "Internal: Ensure Check",
      "module": "werewolf_agent.api.app",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "WEREWOLF_LOG_FILE_NAME": "api.jsonl"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Debug: Worker",
      "type": "debugpy",
      "request": "launch",
      "preLaunchTask": "Internal: Ensure Check",
      "module": "werewolf_agent.worker.app",
      "args": ["run"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "WEREWOLF_LOG_FILE_NAME": "worker.jsonl"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Internal: React",
      "type": "pwa-chrome",
      "request": "launch",
      "preLaunchTask": "Internal: Frontend Dev",
      "url": "http://127.0.0.1:5173",
      "webRoot": "${workspaceFolder}/frontend/src",
      "presentation": { "hidden": true }
    },
    {
      "name": "Internal: Streamlit",
      "type": "debugpy",
      "request": "launch",
      "preLaunchTask": "Internal: Ensure Check",
      "module": "streamlit",
      "args": [
        "run",
        "src/werewolf_agent/clients/streamlit/app.py",
        "--server.address",
        "127.0.0.1",
        "--server.headless",
        "true",
        "--browser.gatherUsageStats",
        "false"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "WEREWOLF_LOG_FILE_NAME": "streamlit.jsonl"
      },
      "console": "integratedTerminal",
      "presentation": { "hidden": true }
    },
    {
      "name": "Internal: CLI Doctor",
      "type": "debugpy",
      "request": "launch",
      "preLaunchTask": "Internal: Ensure Check",
      "module": "werewolf_agent",
      "args": ["doctor"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "presentation": { "hidden": true }
    },
    {
      "name": "Run: CLI Play",
      "type": "debugpy",
      "request": "launch",
      "preLaunchTask": "Internal: Ensure Check",
      "module": "werewolf_agent",
      "args": [
        "play",
        "--role-count",
        "werewolf=1",
        "--role-count",
        "seer=1",
        "--role-count",
        "knight=1",
        "--role-count",
        "villager=3",
        "--seed",
        "1"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    },
    {
      "name": "Verify: Quality",
      "type": "debugpy",
      "request": "launch",
      "module": "scripts.workbench",
      "args": ["verify", "${input:qualityLevel}"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Review: Evidence",
      "type": "debugpy",
      "request": "launch",
      "module": "scripts.workbench",
      "args": ["review", "${input:reviewKind}"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Open: Latest Quality Report",
      "type": "debugpy",
      "request": "launch",
      "module": "scripts.workbench",
      "args": ["open-report"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Cleanup: Owned Resources",
      "type": "debugpy",
      "request": "launch",
      "module": "scripts.workbench",
      "args": ["cleanup"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "Run: React Stack",
      "configurations": [
        "Internal: Supabase Stack",
        "Debug: API",
        "Debug: Worker",
        "Internal: React"
      ],
      "preLaunchTask": "Internal: Supabase Preflight",
      "stopAll": true
    },
    {
      "name": "Run: Streamlit Stack",
      "configurations": [
        "Internal: Supabase Stack",
        "Debug: API",
        "Debug: Worker",
        "Internal: Streamlit"
      ],
      "preLaunchTask": "Internal: Supabase Preflight",
      "stopAll": true
    }
  ],
  "inputs": [
    {
      "id": "qualityLevel",
      "type": "pickString",
      "description": "品質levelを選択",
      "options": ["quick", "check", "release", "deep"],
      "default": "quick"
    },
    {
      "id": "reviewKind",
      "type": "pickString",
      "description": "読解用の証拠を選択",
      "options": ["ui", "gameplay", "local-llm"],
      "default": "ui"
    }
  ]
}
