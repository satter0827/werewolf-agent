{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "内部: Python環境を確認",
      "type": "process",
      "command": "uv",
      "args": ["run", "--no-project", "python", "-m", "scripts.environment", "check", "python"],
      "options": { "cwd": "${workspaceFolder}" },
      "hide": true,
      "problemMatcher": []
    },
    {
      "label": "内部: 開発環境を確認",
      "type": "process",
      "command": "uv",
      "args": ["run", "--no-project", "python", "-m", "scripts.environment", "check", "development"],
      "options": { "cwd": "${workspaceFolder}" },
      "hide": true,
      "problemMatcher": []
    },
    {
      "label": "内部: Supabaseの準備完了を待つ",
      "type": "process",
      "command": "uv",
      "args": ["run", "--no-sync", "python", "-m", "scripts.supabase", "wait", "--timeout", "180"],
      "options": { "cwd": "${workspaceFolder}" },
      "hide": true,
      "problemMatcher": []
    },
    {
      "label": "内部: Full Stackを予約",
      "type": "process",
      "command": "uv",
      "args": ["run", "--no-sync", "python", "-m", "scripts.supabase", "reserve", "full-stack"],
      "dependsOn": ["内部: 開発環境を確認"],
      "dependsOrder": "sequence",
      "options": { "cwd": "${workspaceFolder}" },
      "hide": true,
      "problemMatcher": []
    },
    {
      "label": "内部: Backendを予約",
      "type": "process",
      "command": "uv",
      "args": ["run", "--no-sync", "python", "-m", "scripts.supabase", "reserve", "backend"],
      "dependsOn": ["内部: 開発環境を確認"],
      "dependsOrder": "sequence",
      "options": { "cwd": "${workspaceFolder}" },
      "hide": true,
      "problemMatcher": []
    },
    {
      "label": "内部: APIを予約",
      "type": "process",
      "command": "uv",
      "args": ["run", "--no-sync", "python", "-m", "scripts.supabase", "reserve", "api"],
      "dependsOn": ["内部: 開発環境を確認"],
      "dependsOrder": "sequence",
      "options": { "cwd": "${workspaceFolder}" },
      "hide": true,
      "problemMatcher": []
    },
    {
      "label": "内部: Workerを予約",
      "type": "process",
      "command": "uv",
      "args": ["run", "--no-sync", "python", "-m", "scripts.supabase", "reserve", "worker"],
      "dependsOn": ["内部: 開発環境を確認"],
      "dependsOrder": "sequence",
      "options": { "cwd": "${workspaceFolder}" },
      "hide": true,
      "problemMatcher": []
    },
    {
      "label": "環境: Pythonを準備",
      "type": "process",
      "command": "uv",
      "args": ["run", "--no-project", "python", "-m", "scripts.environment", "setup", "python"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "環境: 開発環境を準備",
      "type": "process",
      "command": "uv",
      "args": ["run", "--no-project", "python", "-m", "scripts.environment", "setup", "development"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "環境: 品質環境を準備",
      "type": "process",
      "command": "uv",
      "args": ["run", "--no-project", "python", "-m", "scripts.environment", "setup", "quality"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "環境: 状態を確認",
      "type": "process",
      "command": "uv",
      "args": ["run", "--no-project", "python", "-m", "scripts.environment", "check", "${input:environmentTarget}"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "品質: Auto",
      "type": "process",
      "command": "uv",
      "args": ["run", "--no-sync", "python", "-m", "scripts.quality", "auto"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "品質: Focus",
      "type": "process",
      "command": "uv",
      "args": ["run", "--no-sync", "python", "-m", "scripts.quality", "focus"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "品質: Check",
      "type": "process",
      "command": "uv",
      "args": ["run", "--no-sync", "python", "-m", "scripts.quality", "check"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "品質: Release",
      "type": "process",
      "command": "uv",
      "args": ["run", "--no-sync", "python", "-m", "scripts.quality", "release"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "品質: Deep",
      "type": "process",
      "command": "uv",
      "args": ["run", "--no-sync", "python", "-m", "scripts.quality", "deep", "--confirm-deep"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "品質: 最新Reportを開く",
      "type": "process",
      "command": "uv",
      "args": ["run", "--no-sync", "python", "-m", "scripts.quality", "report", "open"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "品質: 生成物を削除",
      "type": "process",
      "command": "uv",
      "args": ["run", "--no-sync", "python", "-m", "scripts.quality", "clean"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "品質: 所有Resourcesを削除",
      "type": "process",
      "command": "uv",
      "args": ["run", "--no-sync", "python", "-m", "scripts.quality", "cleanup", "--confirm"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "レビュー: UI",
      "type": "process",
      "command": "uv",
      "args": ["run", "--no-sync", "python", "-m", "scripts.review", "ui"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "レビュー: Gameplay",
      "type": "process",
      "command": "uv",
      "args": ["run", "--no-sync", "python", "-m", "scripts.review", "gameplay"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "レビュー: Local LLM",
      "type": "process",
      "command": "uv",
      "args": ["run", "--no-sync", "python", "-m", "scripts.review", "local-llm"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "診断: 情報を収集",
      "type": "process",
      "command": "uv",
      "args": ["run", "--no-sync", "python", "-m", "scripts.diagnostics", "collect"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "environmentTarget",
      "type": "pickString",
      "description": "確認する環境を選択",
      "options": ["python", "development", "quality"],
      "default": "python"
    }
  ]
}
