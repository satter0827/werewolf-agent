{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Supabase: Preflight",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "scripts.preflight_supabase"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Frontend: Dev",
      "type": "npm",
      "script": "dev",
      "path": "frontend",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
