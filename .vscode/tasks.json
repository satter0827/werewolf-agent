{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Quality: Quick",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "scripts.quality", "quick"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
