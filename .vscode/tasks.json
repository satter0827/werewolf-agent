{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Internal: Ensure Quick",
      "type": "process",
      "command": "uv",
      "args": ["run", "--no-project", "python", "-m", "scripts.environment", "ensure", "quick"],
      "options": { "cwd": "${workspaceFolder}" },
      "hide": true,
      "problemMatcher": []
    },
    {
      "label": "Internal: Ensure Check",
      "type": "process",
      "command": "uv",
      "args": ["run", "--no-project", "python", "-m", "scripts.environment", "ensure", "check"],
      "options": { "cwd": "${workspaceFolder}" },
      "hide": true,
      "problemMatcher": []
    },
    {
      "label": "Internal: Ensure Release",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "python",
        "-m",
        "scripts.environment",
        "ensure",
        "release"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "hide": true,
      "problemMatcher": []
    },
    {
      "label": "Internal: Ensure Deep",
      "type": "process",
      "command": "uv",
      "args": ["run", "--no-project", "python", "-m", "scripts.environment", "ensure", "deep"],
      "options": { "cwd": "${workspaceFolder}" },
      "hide": true,
      "problemMatcher": []
    },
    {
      "label": "Internal: Supabase Preflight",
      "type": "process",
      "command": "uv",
      "args": ["run", "--no-sync", "python", "-m", "scripts.supabase", "preflight"],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": ["Internal: Ensure Release"],
      "dependsOrder": "sequence",
      "hide": true,
      "problemMatcher": []
    },
    {
      "label": "Internal: Supabase Stop",
      "type": "process",
      "command": "uv",
      "args": ["run", "--no-sync", "python", "-m", "scripts.supabase", "stop"],
      "options": { "cwd": "${workspaceFolder}" },
      "hide": true,
      "problemMatcher": []
    },
    {
      "label": "Internal: Frontend Dev",
      "type": "npm",
      "script": "dev",
      "path": "frontend",
      "dependsOn": ["Internal: Ensure Check"],
      "dependsOrder": "sequence",
      "isBackground": true,
      "hide": true,
      "problemMatcher": [
        {
          "owner": "frontend-dev",
          "pattern": { "regexp": ".*" },
          "background": {
            "activeOnStart": true,
            "beginsPattern": ".*",
            "endsPattern": "Local:.*http://127\\.0\\.0\\.1:5173"
          }
        }
      ]
    },
    {
      "label": "Project: Setup",
      "type": "process",
      "command": "uv",
      "args": ["run", "--no-project", "python", "-m", "scripts.environment", "setup", "check"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Verify: Quick",
      "type": "process",
      "command": "uv",
      "args": ["run", "--no-sync", "python", "-m", "scripts.quality", "quick"],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": ["Internal: Ensure Quick"],
      "dependsOrder": "sequence",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Verify: Check",
      "type": "process",
      "command": "uv",
      "args": ["run", "--no-sync", "python", "-m", "scripts.quality", "check"],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": ["Internal: Ensure Check"],
      "dependsOrder": "sequence",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Verify: Release",
      "type": "process",
      "command": "uv",
      "args": ["run", "--no-sync", "python", "-m", "scripts.quality", "release"],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": ["Internal: Ensure Release"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Verify: Deep",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "--no-sync",
        "python",
        "-m",
        "scripts.quality",
        "deep",
        "--confirm-deep"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": ["Internal: Ensure Deep"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Docs: Build",
      "type": "process",
      "command": "uv",
      "args": ["run", "--no-sync", "python", "-m", "scripts.docs", "build"],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": ["Internal: Ensure Check"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Architecture: Analyze",
      "type": "process",
      "command": "uv",
      "args": ["run", "--no-sync", "python", "-m", "scripts.architecture"],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": ["Internal: Ensure Quick"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Dependencies: Python Audit",
      "type": "process",
      "command": "uv",
      "args": ["tree", "--outdated"],
      "options": { "cwd": "${workspaceFolder}" },
      "hide": true,
      "problemMatcher": []
    },
    {
      "label": "Dependencies: Frontend Audit",
      "type": "process",
      "command": "npm",
      "args": ["audit"],
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "hide": true,
      "problemMatcher": []
    },
    {
      "label": "Dependencies: Audit",
      "dependsOn": ["Dependencies: Python Audit", "Dependencies: Frontend Audit"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
